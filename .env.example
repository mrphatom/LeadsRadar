# Runtime mode. Production fails closed when required secrets and HTTPS configuration are absent.
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
JSON_BODY_LIMIT=256kb

# Google Places is the only lead discovery/enrichment source. Without this key,
# discovery and enrichment return an unavailable response; no synthetic leads are generated.
GOOGLE_PLACES_API_KEY=

# Optional for clearly labeled generated guidance only (pitch, SWOT hypotheses, assistant).
# It is never used as a source of business identity or contact facts.
GEMINI_API_KEY=
FIREBASE_SERVICE_ACCOUNT=
ENCRYPTION_KEY=

# MoonPay Fiat On-Ramp. Publishable keys may appear in signed widget URLs;
# secret keys and webhook keys must remain server-side and must never be committed.
MOONPAY_ENVIRONMENT=sandbox
MOONPAY_PUBLISHABLE_KEY=
MOONPAY_SECRET_KEY=
MOONPAY_WEBHOOK_SECRET=
TREASURY_WALLET_ADDRESS=
MOONPAY_BASE_CURRENCY_CODE=usd
MOONPAY_CURRENCY_CODE=usdc
MOONPAY_MONTHLY_AMOUNT=7
MOONPAY_YEARLY_AMOUNT=64

# Optional Firebase Admin configuration when running outside the managed runtime.
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Production requirements:
# Use Node.js 22 or newer. Firebase Admin SDK 14 does not support Node 18 or 20.
# NODE_ENV=production
# APP_URL=https://your-https-domain.example
# ALLOWED_ORIGINS=https://your-https-domain.example
# ENCRYPTION_KEY must decode to at least 32 bytes and must never be committed.
# FIREBASE_SERVICE_ACCOUNT must be supplied through a secret manager, not source control.
# GOOGLE_PLACES_API_KEY must be a server-side secret; request only the documented fields needed by the app.
# Configure the MoonPay webhook URL as https://your-https-domain.example/api/webhooks/moonpay.
# MOONPAY_WEBHOOK_SECRET must contain MoonPay's webhook API key from the Developers page.
# TREASURY_WALLET_ADDRESS must be the exact wallet configured to receive the on-ramp asset.
# Set MOONPAY_ENVIRONMENT=production in production; sandbox is the safe local default.
# Keep the publishable key and secret/webhook keys from the same MoonPay environment.
# See docs/deployment-secrets.md for provider-by-provider acquisition instructions.
