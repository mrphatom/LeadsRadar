[Unit]
Description=LeadsRadar production Docker Compose service
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
ConditionPathExists=/opt/leadsradar/docker-compose.production.yml
ConditionPathExists=/etc/leadsradar/production.env

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/leadsradar
Environment=COMPOSE_FILE=/opt/leadsradar/docker-compose.production.yml
Environment=LEADSRADAR_ENV_FILE=/etc/leadsradar/production.env
Environment=LEADSRADAR_IMAGE=leadsradar:node22

# Fail before changing containers if the Compose file or external env file is invalid.
ExecStartPre=/usr/bin/test -r /etc/leadsradar/production.env
ExecStartPre=/usr/bin/docker compose -f ${COMPOSE_FILE} config --quiet
ExecStart=/usr/bin/docker compose -f ${COMPOSE_FILE} up -d --no-build --remove-orphans
ExecStop=/usr/bin/docker compose -f ${COMPOSE_FILE} down
ExecReload=/usr/bin/docker compose -f ${COMPOSE_FILE} up -d --no-build --remove-orphans

# The Docker daemon controls the application container's UID and capabilities.
# These settings harden this service's Docker CLI process as well.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
UMask=0077
TimeoutStartSec=120
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
